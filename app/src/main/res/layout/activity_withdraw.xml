<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B2B1E"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Withdraw Funds"
        android:textColor="#FFD700"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Enter Bank / UPI Details"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/etAccountName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#134E35"
        android:hint="Account Holder Name"
        android:textColor="#FFFFFF"
        android:textColorHint="#A0A0A0"
        android:padding="12dp" />

    <EditText
        android:id="@+id/etAccountNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#134E35"
        android:hint="Bank Account Number / UPI ID"
        android:inputType="text"
        android:textColor="#FFFFFF"
        android:textColorHint="#A0A0A0"
        android:padding="12dp" />

    <EditText
        android:id="@+id/etAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#134E35"
        android:hint="Enter Amount (Min ৳100)"
        android:inputType="numberDecimal"
        android:textColor="#FFFFFF"
        android:textColorHint="#A0A0A0"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnSubmitWithdraw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#00AA55"
        android:text="Withdraw Now"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</LinearLayout>
